{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Run Assistant Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: Run All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Benchmark: Run Retrieval Evaluation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval_retrieval.py",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}

